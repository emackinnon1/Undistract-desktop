{
  "manifest_version": 2,
  "name": "Undistract Blocker (Prototype)",
  "version": "0.1.0",
  "description": "Blocks domains using a local desktop companion.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage", "nativeMessaging"],
  "browser_specific_settings": {
    "gecko": {
      "id": "undistract@local"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
